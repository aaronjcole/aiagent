# ---------------------------------------------------------------------------
# Example environment configuration. Copy to `.env` and fill in real values.
# This file MUST contain placeholders ONLY — never commit real secrets.
# ---------------------------------------------------------------------------

# Core
NODE_ENV=development
LOG_LEVEL=info

# Database (Postgres)
# Required in production: when NODE_ENV=production an unset/empty DATABASE_URL
# FAILS CLOSED (loadConfig throws) rather than defaulting to localhost. In
# development/test a missing value falls back to postgresql://localhost:5432/aiagent.
DATABASE_URL=postgresql://user:password@localhost:5432/aiagent?schema=public

# Temporal
TEMPORAL_ADDRESS=localhost:7233

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock            # mock | openai | anthropic
OPENAI_API_KEY=sk-REPLACE_ME
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ---------------------------------------------------------------------------
# Email provider
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=mock          # mock | gmail
GMAIL_CLIENT_ID=REPLACE_ME
GMAIL_CLIENT_SECRET=REPLACE_ME
GMAIL_REFRESH_TOKEN=REPLACE_ME
GMAIL_REDIRECT_URI=http://localhost:3000/oauth/gmail/callback
GMAIL_USER=me@example.com

# ---------------------------------------------------------------------------
# Calendar provider
# ---------------------------------------------------------------------------
CALENDAR_PROVIDER=mock       # mock | google
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME
GOOGLE_REFRESH_TOKEN=REPLACE_ME
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback
GOOGLE_CALENDAR_ID=primary

# ---------------------------------------------------------------------------
# Research provider
# ---------------------------------------------------------------------------
RESEARCH_PROVIDER=mock       # mock | live

# ---------------------------------------------------------------------------
# Safety gates (default OFF — outbound sending is disabled by default)
# ---------------------------------------------------------------------------
AUTO_SEND_ENABLED=false
SENDING_ENABLED=false
# Controlled-autonomy master env flags (default OFF). Must be on AND the matching
# SystemSetting autonomy mode set before any autonomous send/booking can occur.
ENABLE_AUTO_SEND=false
ENABLE_AUTO_SCHEDULING=false
DAILY_SEND_CAP=200
PER_INBOX_DAILY_CAP=50
PER_DOMAIN_DAILY_CAP=10
SEQUENCE_MAX_STEPS=5
PER_PROSPECT_MAX_SENDS=5     # lifetime sends per prospect across all sequences; <= 0 means unlimited

# ---------------------------------------------------------------------------
# Sender identity / compliance footer
# ---------------------------------------------------------------------------
DEFAULT_FROM_EMAIL=outreach@example.com
DEFAULT_FROM_NAME=Example Outreach Team
COMPANY_ADDRESS=123 Example St, Suite 100, San Francisco, CA 94105, USA
UNSUBSCRIBE_BASE_URL=https://example.com/unsubscribe
# Secret for signing one-click unsubscribe tokens. Leave EMPTY (unset) to
# disable the RFC 8058 one-click https mechanism entirely — without a secret the
# app will NOT advertise a one-click link (it never emits an unverifiable
# ?email= link), falling back to the mailto unsubscribe only. Set a long random
# value to enable signed ?token= one-click unsubscribe.
UNSUBSCRIBE_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# API auth
# ---------------------------------------------------------------------------
# Shared bearer secret used to authenticate API requests. apps/api requires
# `Authorization: Bearer <API_AUTH_TOKEN>` on all routes except /health and the
# recipient /unsubscribe endpoints. apps/admin's server-side proxy reads the
# same value (server-side only — never NEXT_PUBLIC) and attaches it to upstream
# calls. Leave EMPTY (unset) for local dev: the API then runs UNAUTHENTICATED and
# logs a warning; in production an unset token FAILS CLOSED (protected routes
# return 503). Generate a long random value for any non-local deployment.
API_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Live settings cache
# ---------------------------------------------------------------------------
# Freshness window (ms) for the live SystemSetting reader that serves autonomy
# modes / kill switches without a process restart. Non-safety-critical reads may
# be up to this stale; the master kill switch + autonomy modes use a forced-fresh
# read path that bypasses this cache at the actual send/book decision point.
# Default 5000. Lower = faster propagation, more DB reads; 0 = re-query per read.
LIVE_SETTINGS_TTL_MS=5000

# ---------------------------------------------------------------------------
# Services
# ---------------------------------------------------------------------------
API_PORT=3001
ADMIN_PORT=3000
