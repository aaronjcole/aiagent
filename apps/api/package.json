{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint .",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "demo": "tsx src/demo.ts"
  },
  "dependencies": {
    "@app/agents": "workspace:*",
    "@app/compliance": "workspace:*",
    "@app/db": "workspace:*",
    "@app/email": "workspace:*",
    "@app/shared": "workspace:*",
    "@app/workflows": "workspace:*",
    "@fastify/rate-limit": "^9.1.0",
    "@temporalio/client": "^1.11.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pino": "^9.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "typescript": "~5.6.2",
    "vitest": "^2.1.2"
  }
}
