{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NEXT_PUBLIC_API_BASE_URL"
  ],
  "globalPassThroughEnv": [
    "PRISMA_QUERY_ENGINE_LIBRARY",
    "PRISMA_SCHEMA_ENGINE_BINARY",
    "PRISMA_ENGINES_MIRROR",
    "PRISMA_CLI_QUERY_ENGINE_TYPE",
    "CHECKPOINT_DISABLE",
    "NODE_EXTRA_CA_CERTS",
    "DATABASE_URL",
    "ADMIN_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
